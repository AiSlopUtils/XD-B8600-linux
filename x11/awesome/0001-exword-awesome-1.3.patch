+void
+drawbevel(Display *disp, DC drawcontext, Drawable drawable, Bool sunken)
+{
+    unsigned long upper, lower;
+
+    if(drawcontext.w < 2 || drawcontext.h < 2)
+        return;
+    upper = sunken ? drawcontext.bevel_shadow : drawcontext.bevel_light;
+    lower = sunken ? drawcontext.bevel_light : drawcontext.bevel_shadow;
+
+    XSetForeground(disp, drawcontext.gc, upper);
+    XDrawLine(disp, drawable, drawcontext.gc,
+              drawcontext.x, drawcontext.y,
+              drawcontext.x + drawcontext.w - 1, drawcontext.y);
+    XDrawLine(disp, drawable, drawcontext.gc,
+              drawcontext.x, drawcontext.y,
+              drawcontext.x, drawcontext.y + drawcontext.h - 1);
+
+    XSetForeground(disp, drawcontext.gc, lower);
+    XDrawLine(disp, drawable, drawcontext.gc,
+              drawcontext.x, drawcontext.y + drawcontext.h - 1,
+              drawcontext.x + drawcontext.w - 1,
+              drawcontext.y + drawcontext.h - 1);
+    XDrawLine(disp, drawable, drawcontext.gc,
+              drawcontext.x + drawcontext.w - 1, drawcontext.y,
+              drawcontext.x + drawcontext.w - 1,
+              drawcontext.y + drawcontext.h - 1);
+}

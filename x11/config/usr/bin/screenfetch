#!/bin/sh

# Text-only system summary for the 16 MiB EX-word Linux port.

mem_total=unknown
mem_free=unknown
mem_available=
swap_total=unknown
swap_free=unknown
while read -r key value unit; do
	case "$key" in
		MemTotal:) mem_total="${value} KiB" ;;
		MemFree:) mem_free="${value} KiB" ;;
		MemAvailable:) mem_available="${value} KiB" ;;
		SwapTotal:) swap_total="${value} KiB" ;;
		SwapFree:) swap_free="${value} KiB" ;;
	esac
done < /proc/meminfo
[ -n "$mem_available" ] || mem_available=$mem_free

cpu="Renesas SH-4A (big-endian)"
while IFS=: read -r key value; do
	case "$key" in
		cpu\ type*|machine*)
			value=${value# }
			[ -n "$value" ] && cpu=$value
			break
			;;
	esac
done < /proc/cpuinfo

resolution=528x320
if [ -r /sys/class/graphics/fb0/virtual_size ]; then
	resolution=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null)
	resolution=${resolution%,*}x${resolution#*,}
fi

up=$(cut -d. -f1 /proc/uptime 2>/dev/null)
[ -n "$up" ] || up=unknown

printf 'Host:     root@%s\n' "$(hostname)"
printf 'OS:       EX-word Linux\n'
printf 'Model:    Casio XD-B8600\n'
printf 'Kernel:   %s\n' "$(uname -r)"
printf 'CPU:      %s\n' "$cpu"
printf 'Memory:   %s total, %s available\n' "$mem_total" "$mem_available"
printf 'Swap:     %s total, %s free\n' "$swap_total" "$swap_free"
printf 'Display:  %s framebuffer\n' "$resolution"
printf 'Shell:    BusyBox ash\n'
printf 'WM:       AwesomeWM 1.3\n'
printf 'Uptime:   %s seconds\n' "$up"

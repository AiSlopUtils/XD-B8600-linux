# AwesomeWM 1.3 configuration for the EX-word keyboard.
# BACK is Linux/X11 Control; F1-F8 are numbers 1-8, PAGE-UP is 9,
# PAGE-DOWN is 0, SYMBOL is Space, and POWER toggles pointer mode.
awesome:
{
    barpos = "bottom";
    borderpx = 2;
    snap = 4;
    mwfact = 0.6;
    font = "fixed";
    tags = ( "Desktop" );

    normal_border_color = "#808080";
    normal_bg_color = "#d4d0c8";
    normal_fg_color = "#000000";
    focus_border_color = "#0a246a";
    focus_bg_color = "#0a246a";
    focus_fg_color = "#ffffff";
    desktop_bg_color = "#3a6ea5";
    bevel_light_color = "#ffffff";
    bevel_shadow_color = "#808080";
    opacity_unfocused = 100;

    layouts = (
        ("><>", "floating"),
        ("[]=", "tile"),
        ("[M]", "max")
    );

    nmaster = 1;
    ncols = 1;
    resize_hints = true;
    # Keep one never-matching rule: old libconfig releases do not reliably
    # preserve the element type of a completely empty list.
    rules = ({ name = "__exword_no_match__";
               tags = "";
               float = false;
             });
    modkey = "Control";

    keys = (
        (("Control"), "Return", "spawn", "exec /opt/x11/usr/bin/xterm -T 'Command Prompt' -tn xterm -fn fixed -bg black -fg white -cr white -geometry 64x20 -sl 64 +sb -ut &"),
        (("Control"), "space", "setlayout", "+1"),
        (("Control", "Shift"), "space", "setlayout", "-1"),
        (("Control"), "j", "focusnext", ""),
        (("Control"), "k", "focusprev", ""),
        (("Control", "Shift"), "j", "swapnext", ""),
        (("Control", "Shift"), "k", "swapprev", ""),
        (("Control"), "h", "setmwfact", "-0.05"),
        (("Control"), "l", "setmwfact", "+0.05"),
        (("Control"), "m", "togglemax", ""),
        (("Control"), "b", "togglebar", ""),
        (("Control", "Shift"), "c", "killclient", ""),
        (("Control"), "q", "quit", ""),

        (("Control"), "1", "view", "Desktop")
    );
};

# Lightweight Holo visual port for AwesomeWM 1.3 on the EX-word keyboard.
# BACK is Linux/X11 Control; F1-F8 are numbers 1-8, PAGE-UP is 9,
# PAGE-DOWN is 0, SYMBOL is Space, and POWER toggles pointer mode.
awesome:
{
    barpos = "bottom";
    borderpx = 1;
    snap = 4;
    mwfact = 0.6;
    font = "fixed";
    tags = ( "Desktop" );

    normal_border_color = "#252525";
    normal_bg_color = "#242424";
    normal_fg_color = "#ffffff";
    focus_border_color = "#0099cc";
    focus_bg_color = "#303030";
    focus_fg_color = "#4cb7db";
    desktop_bg_color = "#242424";
    bevel_light_color = "#0099cc";
    bevel_shadow_color = "#111111";
    opacity_unfocused = 100;

    layouts = (
        ("><>", "floating"),
        ("[]=", "tile"),
        ("[M]", "max")
    );

    nmaster = 1;
    ncols = 1;
    resize_hints = true;
    rules = ({ name = "Snake";
               tags = "Desktop";
               float = true;
             });
    modkey = "Control";

    keys = (
        (("Control"), "Return", "spawn", "exec /opt/x11/usr/bin/xterm -T 'Command Prompt' -tn xterm -fn fixed -bg '#242424' -fg white -cr '#0099cc' -geometry 64x20 -sl 64 +sb -ut &"),
        (("Control"), "space", "setlayout", "+1"),
        (("Control", "Shift"), "space", "setlayout", "-1"),
        (("Control"), "j", "focusnext", ""),
        (("Control"), "k", "focusprev", ""),
        (("Control", "Shift"), "j", "swapnext", ""),
        (("Control", "Shift"), "k", "swapprev", ""),
        (("Control"), "h", "setmwfact", "-0.05"),
        (("Control"), "l", "setmwfact", "+0.05"),
        (("Control"), "m", "togglemax", ""),
        (("Control"), "b", "togglebar", ""),
        (("Control", "Shift"), "c", "killclient", ""),
        (("Control"), "q", "quit", ""),

        (("Control"), "1", "view", "Desktop")
    );
};

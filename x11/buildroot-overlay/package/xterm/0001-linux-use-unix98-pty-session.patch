From: EX-word Linux port <exword@localhost>
Subject: [PATCH] xterm: use Linux Unix98 PTYs and controlling terminal setup

The xterm 327 configure probe cannot run while cross-compiling and therefore
disables the posix_openpt path even though musl provides it.  Linux also needs
setsid() and TIOCSCTTY in the child before launching the shell.  Without these
paths xterm repeatedly tries unavailable legacy tty devices and eventually
fails with EAGAIN on the 16 MiB EX-word target.

---
 main.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/main.c b/main.c
--- a/main.c
+++ b/main.c
@@ -2798,7 +2798,7 @@ pty_search(int *pty)
 	close(opened_tty);
 	opened_tty = -1;
     }
-#elif defined(HAVE_POSIX_OPENPT) && defined(HAVE_PTSNAME) && defined(HAVE_GRANTPT_PTY_ISATTY)
+#elif defined(HAVE_POSIX_OPENPT) && defined(HAVE_PTSNAME)
     if ((*pty = posix_openpt(O_RDWR)) >= 0) {
 	char *name = ptsname(*pty);
 	if (name != 0) {
@@ -3879,7 +3879,7 @@ spawnXTerm(XtermWidget xw, unsigned line_speed)
 	    /*
 	     * now in child process
 	     */
-#if defined(_POSIX_SOURCE) || defined(SVR4) || defined(__convex__) || defined(__SCO__) || defined(__QNX__)
+#if defined(_POSIX_SOURCE) || defined(__linux__) || defined(SVR4) || defined(__convex__) || defined(__SCO__) || defined(__QNX__)
 	    int pgrp = setsid();	/* variable may not be used... */
 #else
 	    int pgrp = getpid();
@@ -4025,7 +4025,7 @@ spawnXTerm(XtermWidget xw, unsigned line_speed)
 			/* make /dev/tty work */
 			ioctl(ttyfd, TCSETCTTY, 0);
 #endif
-#if ((defined(__GLIBC__) && defined(__FreeBSD_kernel__)) || defined(__GNU__)) && defined(TIOCSCTTY)
+#if (defined(__linux__) || (defined(__GLIBC__) && defined(__FreeBSD_kernel__)) || defined(__GNU__)) && defined(TIOCSCTTY)
 			/* make /dev/tty work */
 			ioctl(ttyfd, TIOCSCTTY, 0);
 #endif
-- 
